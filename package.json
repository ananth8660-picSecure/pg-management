{
    "name":  "pg-ops-premium",
    "version":  "1.34.15",
    "private":  true,
    "scripts":  {
                    "ng":  "ng",
                    "start":  "npm run clean:dev \u0026\u0026 npm run verify:angular-runtime \u0026\u0026 ng serve --configuration development --prebundle=false --hmr=false",
                    "build":  "ng build",
                    "watch":  "ng build --watch --configuration development",
                    "deploy:rules":  "firebase deploy --only firestore:rules",
                    "r2:install":  "cd r2-worker \u0026\u0026 npm install",
                    "r2:bucket":  "cd r2-worker \u0026\u0026 npm run create:bucket",
                    "r2:deploy":  "cd r2-worker \u0026\u0026 npm run deploy",
                    "functions:install":  "cd functions \u0026\u0026 npm install",
                    "functions:build":  "cd functions \u0026\u0026 npm run build",
                    "functions:deploy":  "cd functions \u0026\u0026 npm run deploy",
                    "deploy:backend":  "firebase deploy --only firestore:rules,functions",
                    "deploy:firebase":  "firebase deploy --only firestore:rules,functions,hosting",
                    "deploy:final":  "npm run functions:build \u0026\u0026 firebase deploy --only firestore:rules,functions,hosting \u0026\u0026 npm run r2:deploy",
                    "verify:final":  "npm run build \u0026\u0026 npm run functions:build",
                    "audit:deps":  "npm audit --omit=dev",
                    "ci:verify":  "npm run build \u0026\u0026 npm run functions:build",
                    "cap:add:android":  "npx cap add android",
                    "cap:sync":  "npx cap sync android",
                    "cap:open":  "npx cap open android",
                    "android:prepare":  "npm run build \u0026\u0026 npm run cap:sync",
                    "android:open":  "npm run android:prepare \u0026\u0026 npm run cap:open",
                    "android:run":  "npm run build \u0026\u0026 npx cap run android",
                    "android:doctor":  "npx cap doctor",
                    "android:init":  "powershell -ExecutionPolicy Bypass -File scripts/init-android.ps1",
                    "android:assets":  "npx @capacitor/assets generate --android",
                    "android:release":  "npm run build \u0026\u0026 npx cap sync android \u0026\u0026 npm run android:brand \u0026\u0026 npm run android:native-updater \u0026\u0026 npm run android:size-optimize \u0026\u0026 npm run android:assets \u0026\u0026 powershell -ExecutionPolicy Bypass -File scripts/apply-android-system-bars.ps1 \u0026\u0026 cd android \u0026\u0026 gradlew.bat assembleRelease",
                    "android:release:prepare":  "powershell -ExecutionPolicy Bypass -File scripts/configure-android-release-signing.ps1",
                    "release:android":  "powershell -ExecutionPolicy Bypass -File scripts/release-android.ps1",
                    "release:android:mandatory":  "powershell -ExecutionPolicy Bypass -File scripts/release-android.ps1 -Mandatory",
                    "android:brand":  "powershell -ExecutionPolicy Bypass -File scripts/apply-android-branding.ps1",
                    "mail:secret":  "firebase functions:secrets:set RESEND_API_KEY",
                    "mail:deploy":  "npm run functions:build \u0026\u0026 firebase deploy --only functions",
                    "android:native-updater":  "powershell -ExecutionPolicy Bypass -File scripts/apply-native-updater.ps1",
                    "firebase:android:prod":  "powershell -ExecutionPolicy Bypass -File scripts/apply-firebase-android-production.ps1",
                    "production:check":  "powershell -ExecutionPolicy Bypass -File scripts/check-production-config.ps1",
                    "verify:deps":  "node scripts/verify-r82-dependencies.cjs",
                    "clean:dev":  "node scripts/clean-angular-dev.cjs",
                    "verify:angular-runtime":  "node scripts/verify-angular-runtime.cjs",
                    "start:fresh":  "npm run clean:dev \u0026\u0026 npm run verify:angular-runtime \u0026\u0026 ng serve --configuration development --host 127.0.0.1 --port 4300 --prebundle=false --hmr=false --live-reload=false",
                    "android:assets:fresh":  "powershell -ExecutionPolicy Bypass -File scripts/prepare-android-assets.ps1 \u0026\u0026 npx @capacitor/assets generate --android",
                    "android:size-optimize":  "powershell -ExecutionPolicy Bypass -File scripts/apply-android-size-optimization.ps1",
                    "prestart":  "node scripts/ensure-angular-material.cjs",
                    "prebuild":  "node scripts/ensure-angular-material.cjs",
                    "prewatch":  "node scripts/ensure-angular-material.cjs"
                },
    "dependencies":  {
                         "@angular/common":  "20.3.16",
                         "@angular/compiler":  "20.3.16",
                         "@angular/core":  "20.3.16",
                         "@angular/forms":  "20.3.16",
                         "@angular/platform-browser":  "20.3.16",
                         "@angular/router":  "20.3.16",
                         "firebase":  "^11.10.0",
                         "rxjs":  "~7.8.2",
                         "tslib":  "^2.8.1",
                         "zone.js":  "~0.15.0",
                         "@capacitor/core":  "8.5.2",
                         "@capacitor/app":  "8.1.1",
                         "@capacitor/browser":  "8.0.4",
                         "@capacitor/network":  "8.0.1",
                         "@capacitor/splash-screen":  "8.0.2",
                         "@capacitor/status-bar":  "8.0.1",
                         "jszip":  "^3.10.1",
                         "@capacitor/push-notifications":  "8.1.2",
                         "@angular/cdk":  "20.2.14",
                         "@angular/material":  "20.2.14",
                         "@angular/animations":  "20.3.16"
                     },
    "devDependencies":  {
                            "@angular/build":  "20.3.16",
                            "@angular/cli":  "20.3.16",
                            "@angular/compiler-cli":  "20.3.16",
                            "typescript":  "~5.9.3",
                            "@capacitor/cli":  "8.5.2",
                            "@capacitor/android":  "8.5.2",
                            "@capacitor/assets":  "3.0.5"
                        }
}
