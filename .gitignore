
# Android production signing identity - never commit private key/passwords
android/*.jks
android/*.keystore
android/keystore.properties
config/firebase/production/google-services.json

# Hosted Android release binaries must never be build inputs.
# They are copied directly to dist during release to prevent APK-inside-APK growth.
public/releases/*.apk
release/*.apk
node_modules/
functions/node_modules/
r2-worker/node_modules/

dist/
.angular/
.firebase/

android/.gradle/
android/build/
android/app/build/
**/build/

release/
*.apk
*.aab

*.log
firestore-debug.log

*.zip
*.tmp

functions/.env*
!functions/.env.mana-pg.example

resend-key.txt
classes.txt